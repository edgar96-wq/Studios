<?xml version="1.0" encoding="utf-8"?>
<!-- Backups and phone-to-phone transfers keep the books but never sign-in tokens or settings files (MSAL's token cache lives there) -->
<data-extraction-rules>
    <cloud-backup><exclude domain="sharedpref" path="." /></cloud-backup>
    <device-transfer><exclude domain="sharedpref" path="." /></device-transfer>
</data-extraction-rules>
